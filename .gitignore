# ========================================================
# .gitignore 说明：
# 本文件用于告诉 Git 哪些本地文件/目录是临时的、私密的或体积庞大的，
# 不需要被版本控制，也不用上传到 GitHub 远端仓库。
# ========================================================

# --------------------------------------------------------
# 1. 本地虚拟环境与敏感私密配置（切勿上传）
# --------------------------------------------------------
# 本地环境变量文件（包含大模型 API-KEY、密码等私密信息，严防泄露）
.env

# 本地 Python 虚拟环境主目录（体积庞大且包含本地二进制依赖）
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --------------------------------------------------------
# 2. Python 运行时自动生成的编译缓存与字节码文件
# --------------------------------------------------------
# Python 解释器运行代码时自动生成的字节码缓存目录
__pycache__/

# 编译产物：.pyc（字节码）、.pyo（优化字节码）、.pyd（Windows DLL 扩展）
*.py[cod]

# Jython 运行时编译的 Java class 文件
*$py.class

# --------------------------------------------------------
# 3. 单元测试与代码覆盖率报告产物
# --------------------------------------------------------
# pytest 自动化测试框架生成的本地运行缓存
.pytest_cache/

# 代码覆盖率统计数据文件
.coverage

# 代码覆盖率生成的 HTML 报告网页目录
htmlcov/

# --------------------------------------------------------
# 4. 自动化测试/AI探索的运行时本地产物（日志、报告与大图截图）
# --------------------------------------------------------
# 本地测试报告归档目录 (运行时产物，一次运行对应一个 runs/<run_id>/)
/reports/

# 旧版运行产物目录 (已被统一迁移至 reports/runs/)
/logs/
/bugs/

# 临时排查/抓取文件
scratch_*.json

# --------------------------------------------------------
# 5. 编辑器与本地 IDE 临时配置文件
# --------------------------------------------------------
# VS Code 编辑器的个人工作区配置与插件设置
.vscode/

# PyCharm / JetBrains IDE 的项目配置目录
.idea/

# Vim 等编辑器在编辑时生成的临时交换文件
*.swp
*.swo


